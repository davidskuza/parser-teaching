// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider      = "prisma-client-js"
    binaryTargets = ["native", "linux-musl", "linux-musl-openssl-3.0.x"]
}

datasource db {
    provider = "postgresql"
    url      = env("PRISMA_DATABASE_URL")
}

model User {
    id                       String                    @id @default(uuid())
    email                    String                    @unique()
    externalId               String?                   @unique()
    authProviderUserId       String?                   @unique()
    cioId                    String?
    firstName                String?
    lastName                 String?
    bankAccount              BankAccount?              @relation(fields: [bankAccountId], references: [id])
    bankAccountId            String?
    vehicleData              VehicleData?              @relation(fields: [vehicleDataId], references: [id])
    vehicleDataId            String?
    representative           Representative?           @relation(fields: [representativeId], references: [id])
    representativeId         String?
    birthDate                DateTime?
    address                  Address?                  @relation(fields: [addressId], references: [id])
    addressId                String?
    telephonePrefix          String?
    phoneNumber              String?
    isPhoneNumberInvalid     Boolean                   @default(false)
    isGod                    Boolean                   @default(false)
    active                   Boolean                   @default(false)
    isBanned                 Boolean                   @default(false)
    userProjects             UserProject[]
    userInvitations          UserInvitation[]
    investors                Investor[]
    contractFiles            ContractFile[]
    kycFiles                 KYCFile[]
    userRoles                UserRole[]                @default([])
    changeEmail              ChangeEmail[]
    preFillableFormTemplates PreFillableFormTemplate[]
    deleted                  Boolean                   @default(false)
    updatedAt                DateTime                  @updatedAt
    createdAt                DateTime                  @default(now())
}

enum UserRole {
    ADMIN
    INVESTOR
}

model UserInvitation {
    id        String   @id @default(uuid())
    token     String   @unique()
    user      User     @relation(fields: [userId], references: [id])
    userId    String
    projectId String?
    project   Project? @relation(fields: [projectId], references: [id])
    used      Boolean  @default(false)
    deleted   Boolean  @default(false)
    updatedAt DateTime @updatedAt
    createdAt DateTime @default(now())
}

model ResetPassword {
    id        String   @id @default(uuid())
    email     String
    token     String   @unique()
    used      Boolean  @default(false)
    deleted   Boolean  @default(false)
    updatedAt DateTime @updatedAt
    createdAt DateTime @default(now())
}

model ChangeEmail {
    id        String   @id @default(uuid())
    newEmail  String
    oldEmail  String
    user      User     @relation(fields: [userId], references: [id])
    userId    String
    token     String   @unique()
    used      Boolean  @default(false)
    deleted   Boolean  @default(false)
    updatedAt DateTime @updatedAt
    createdAt DateTime @default(now())
}

model Organization {
    id        String    @id @default(uuid())
    name      String
    projects  Project[]
    deleted   Boolean   @default(false)
    updatedAt DateTime  @updatedAt
    createdAt DateTime  @default(now())
}

model Project {
    id                               String                           @id @default(uuid())
    organization                     Organization?                    @relation(fields: [organizationId], references: [id])
    organizationId                   String?
    userInvitation                   UserInvitation[]
    name                             String
    targetName                       String
    userProjects                     UserProject[]
    mips                             Mip[]
    backbookId                       String?
    preFillableFormTemplatesProjects PreFillableFormTemplateProject[]
    deleted                          Boolean                          @default(false)
    updatedAt                        DateTime                         @updatedAt
    createdAt                        DateTime                         @default(now())
}

model Address {
    id                  String           @id @default(uuid())
    country             String?
    city                String?
    postCode            String?
    street              String?
    houseNumber         String?
    singleAddressString String?
    users               User[]
    representatives     Representative[]
    vehicleDatas        VehicleData[]
    deleted             Boolean          @default(false)
    updatedAt           DateTime         @updatedAt
    createdAt           DateTime         @default(now())
}

model Mip {
    id                    String              @id @default(uuid())
    cioInvestorSegmentId  Int?
    cioManagerSegmentId   Int?
    project               Project             @relation(fields: [projectId], references: [id])
    projectId             String
    bankAccount           BankAccount?        @relation(fields: [bankAccountId], references: [id])
    bankAccountId         String?
    entityName            String?
    programmeName         String?
    state                 MipState            @default(DRAFT)
    currency              CurrencyType        @default(EUR)
    securities            Security[]
    isKYCOptional         Boolean?            @default(false)
    investors             Investor[]
    customDetails         CustomDetail[]
    contractFiles         ContractFile[]
    collaborators         DraftCollaborator[]
    backbookExternalIds   Json?
    workflowSettings      Json?
    deleted               Boolean             @default(false)
    updatedAt             DateTime            @updatedAt
    createdAt             DateTime            @default(now())
    documentFiles         DocumentFile[]
    securityValuationDate DateTime?
    backbookId            String?
    isLocked              Boolean             @default(false)
    loanDefinitions       LoanDefinition[]
    vestingTerms          VestingTerm[]
}

enum MipState {
    DRAFT
    ACTIVE
    ARCHIVED
}

model BankAccount {
    id                   String   @id @default(uuid())
    bankName             String?
    accountHolder        String?
    iban                 String?
    swiftCode            String?
    investorInstructions String?
    accountNumber        String?
    country              String?
    mips                 Mip[]
    deleted              Boolean  @default(false)
    updatedAt            DateTime @updatedAt
    createdAt            DateTime @default(now())
    users                User[]
}

model Security {
    id                  String             @id @default(uuid())
    mip                 Mip                @relation(fields: [mipId], references: [id])
    mipId               String
    name                String
    type                SecurityType       @default(OTHER)
    votesPerShare       Int?
    nominalValue        Decimal?           @db.Decimal(15, 5)
    valuePerUnit        Decimal?           @db.Decimal(15, 2)
    shareAssociations   ShareAssociation[]
    backbookId          String?
    backbookDescription String?
    backbookFaceValue   Decimal?
    backbookCurrency    CurrencyType?
    subjectToVesting    Boolean            @default(false)
    deleted             Boolean            @default(false)
    updatedAt           DateTime           @updatedAt
    createdAt           DateTime           @default(now())

    @@unique([mipId, name, type])
}

enum CurrencyType {
    EUR
    GBP
    USD
    DKK
    NOK
    PLN
    SEK
    CHF
}

enum SecurityType {
    LOAN
    PREFERENCE_SHARE
    TRACKING_SHARE
    PARTNERSHIP_UNIT
    OPTIONS
    ORDINARY_SHARE
    VIRTUAL_EQUITY
    OTHER
    WARRANT
    OTHER_EQUITY
}

model TransactionShareAssociation {
    id                    String                                     @id @default(uuid())
    investor              Investor                                   @relation(fields: [investorId], references: [id])
    investorId            String
    shareAssociations     ShareAssociation[]
    paymentAnnotation     String?
    paymentStatus         TransactionState                           @default(PENDING)
    isCompleted           Boolean                                    @default(false)
    type                  TransactionShareAssociationType
    completionStep        TransactionShareAssociationCompletionStep?
    investorContractFiles InvestorContractFile[]
    deleted               Boolean                                    @default(false)
    updatedAt             DateTime                                   @updatedAt
    createdAt             DateTime                                   @default(now())
    processSettings       Json?
    loans                 Loan[]
}

enum TransactionShareAssociationType {
    JOINER_CREATE
    JOINER
    ALLOCATION
    LEAVER
}

enum TransactionShareAssociationCompletionStep {
    PERSONAL_INFORMATION
    INVESTMENT_VEHICLE_INFORMATION
    BANK_ACCOUNT
    OTHER
    KYC_INSTRUCTIONS
    KYC_PERSONAL
    KYC_COMPANY
    KYC_FORMS
    DECLARATIONS
    CONTRACTS
    COMPLETED
}

model ShareAssociation {
    id                            String                       @id @default(uuid())
    security                      Security                     @relation(fields: [securityId], references: [id])
    securityId                    String
    vestingTerm                   VestingTerm?                 @relation(fields: [vestingTermId], references: [id])
    vestingTermId                 String?
    number                        Decimal                      @db.Decimal(15, 0)
    cost                          Decimal                      @db.Decimal(15, 2)
    isNegative                    Boolean                      @default(false)
    deleted                       Boolean                      @default(false)
    updatedAt                     DateTime                     @updatedAt
    createdAt                     DateTime                     @default(now())
    transactionShareAssociation   TransactionShareAssociation? @relation(fields: [transactionShareAssociationId], references: [id])
    transactionShareAssociationId String?
    transactionType               TransactionType?
}

enum TransactionType {
    TRANSFER
    ISSUE
    REDEMPTION
}

enum TransactionState {
    PENDING
    INCOMPLETE
    COMPLETED
}

model AddoSigningConfiguration {
    country              String     @id
    authenticationMethod Int
    signingMethod        Int
    investors            Investor[]
    updatedAt            DateTime   @default(now()) @updatedAt
    createdAt            DateTime   @default(now())
    deleted              Boolean    @default(false)
}

model Investor {
    id                           String                        @id @default(uuid())
    user                         User                          @relation(fields: [userId], references: [id])
    userId                       String
    mip                          Mip                           @relation(fields: [mipId], references: [id])
    mipId                        String
    declarations                 Declaration[]
    state                        InvestorState                 @default(CREATE_AND_COLLABORATE)
    isInvestmentVehicles         Boolean                       @default(false)
    investorCustomDetails        InvestorCustomDetail[]
    kycFiles                     KYCFile[]
    investorInvitations          InvestorInvitation[]
    deleted                      Boolean                       @default(false)
    updatedAt                    DateTime                      @updatedAt
    createdAt                    DateTime                      @default(now())
    addoSigningConfiguration     AddoSigningConfiguration?     @relation(fields: [addoSigningConfigurationId], references: [country])
    addoSigningConfigurationId   String?
    isKycOptional                Boolean?                      @default(false)
    transactionShareAssociations TransactionShareAssociation[]
    processSettings              Json?
    backbookId                   String?
    documents                    Document[]
    totalHoldings                Decimal?                      @db.Decimal(15, 2)
    totalPending                 Decimal?                      @db.Decimal(15, 2)
    investmentStatus             InvestmentStatus              @default(NOT_SENT_OUT)
    totalContracts               Int?
    totalSecurities              Int?
    programmeStatus              ProgrammeStatus               @default(INACTIVE)
}

// https://dealstack-workspace.slack.com/archives/C03HGAA7T19/p1655806660405919
enum InvestorState {
    CREATE_AND_COLLABORATE
    REVIEW_AND_SEND
    COLLECT_AND_APPROVE
    MONITOR_AND_CHANGE
    EXIT_AND_ARCHIVE
}

enum InvestmentStatus {
    NOT_SENT_OUT
    AWAITING_INVESTOR
    PENDING_APPROVAL
    PENDING_RELEASE
    COMPLETED
}

enum ProgrammeStatus {
    JOINER
    HOLDER
    LEAVER
    INACTIVE
}

model InvestorInvitation {
    id         String   @id @default(uuid())
    token      String   @unique()
    investor   Investor @relation(fields: [investorId], references: [id])
    investorId String
    used       Boolean  @default(false)
    deleted    Boolean  @default(false)
    updatedAt  DateTime @updatedAt
    createdAt  DateTime @default(now())
}

model VehicleData {
    id               String   @id @default(uuid())
    pivName          String
    corporateNumber  String?
    address          Address  @relation(fields: [addressId], references: [id], onDelete: Cascade)
    addressId        String
    users            User[]
    isSponsorCompany Boolean?
    deleted          Boolean  @default(false)
    updatedAt        DateTime @updatedAt
    createdAt        DateTime @default(now())
}

model Declaration {
    id               String            @id @default(uuid())
    checked          Boolean
    type             DeclarationType
    description      String?
    rejectionComment String?
    status           AcceptanceStatus?
    investor         Investor?         @relation(fields: [investorId], references: [id])
    deleted          Boolean           @default(false)
    updatedAt        DateTime          @updatedAt
    createdAt        DateTime          @default(now())
    investorId       String?
}

enum DeclarationType {
    BENEFICIAL_OWNERSHIP
    POLITICALLY_EXPOSED_PERSON
    SOURCE_OF_FUNDS_SALARY
    SOURCE_OF_FUNDS_INHERITANCE
    SOURCE_OF_FUNDS_INVESTMENT_INCOME
    SOURCE_OF_FUNDS_PERSONAL_SAVINGS
    SOURCE_OF_FUNDS_OTHER
}

model Representative {
    id              String    @id @default(uuid())
    users           User[]
    email           String
    firstName       String
    lastName        String
    birthDate       DateTime?
    address         Address?  @relation(fields: [addressId], references: [id])
    telephonePrefix String?
    phoneNumber     String?
    addressId       String?
    deleted         Boolean   @default(false)
    updatedAt       DateTime  @updatedAt
    createdAt       DateTime  @default(now())
}

model CustomDetail {
    id                                    String                                 @id @default(uuid())
    mip                                   Mip                                    @relation(fields: [mipId], references: [id])
    mipId                                 String
    name                                  String
    instruction                           String?
    type                                  CustomDetailEnum                       @default(INDIVIDUAL)
    dataType                              CustomDetailDataTypeEnum               @default(STRING)
    investorCustomDetail                  InvestorCustomDetail[]
    isChecked                             Boolean                                @default(false)
    isPredefined                          Boolean                                @default(false)
    fileId                                String?
    file                                  File?                                  @relation("CustomDetailsFiles", fields: [fileId], references: [id])
    preFillableTemplateFieldCustomDetails PreFillableTemplateFieldCustomDetail[]
    preFillableFormTemplateId             String?
    preFillableFormTemplate               PreFillableFormTemplate?               @relation(fields: [preFillableFormTemplateId], references: [id])
    kycFiles                              KYCFile[]                              @relation("KycFiles")
    deleted                               Boolean                                @default(false)
    updatedAt                             DateTime                               @updatedAt
    createdAt                             DateTime                               @default(now())
}

enum CustomDetailEnum {
    INDIVIDUAL
    VEHICLE
}

enum CustomDetailDataTypeEnum {
    STRING
    NUMBER
    BOOLEAN
    BANK_ACCOUNT
    TAX_RESIDENCY
    FORM
    PRE_FILLABLE_FORM
}

model InvestorCustomDetail {
    id             String       @id @default(uuid())
    value          String
    investor       Investor     @relation(fields: [investorId], references: [id])
    investorId     String
    customDetail   CustomDetail @relation(fields: [customDetailId], references: [id])
    customDetailId String
    deleted        Boolean      @default(false)
    updatedAt      DateTime     @updatedAt
    createdAt      DateTime     @default(now())
}

model UserProject {
    id              String      @id @default(uuid())
    user            User        @relation(fields: [userId], references: [id])
    userId          String
    project         Project     @relation(fields: [projectId], references: [id])
    projectId       String
    role            ProjectRole @default(COLLABORATOR)
    isContactPerson Boolean     @default(false)
    deleted         Boolean     @default(false)
    updatedAt       DateTime    @updatedAt
    createdAt       DateTime    @default(now())

    @@unique([userId, projectId])
}

enum ProjectRole {
    OWNER
    COLLABORATOR
}

model File {
    id                          String                    @id @default(uuid())
    name                        String
    mimeType                    String
    extension                   String
    s3key                       String
    contractFiles               ContractFile[]            @relation("ContractFileFile")
    multiSignatureContractFiles ContractFile[]            @relation("ContractFileMultiSignatureFile")
    kycFiles                    KYCFile[]
    investorContractFile        InvestorContractFile?     @relation("InvestorContractFileCombinedFile")
    counterpartySignatories     CounterpartySignature[]   @relation("CounterpartySignatureSignedFile")
    counterpartyContractFiles   CounterpartySignature[]   @relation("CounterpartySignatureContractFile")
    customDetailsFiles          CustomDetail[]            @relation("CustomDetailsFiles")
    investorSignatories         InvestorSignature[]
    pivSignatories              PivSignature[]
    investorContractSignedFile  InvestorContractFile?     @relation("InvestorContractFileSignedFile")
    preFillableFormTemplates    PreFillableFormTemplate[]
    deleted                     Boolean                   @default(false)
    updatedAt                   DateTime                  @updatedAt
    createdAt                   DateTime                  @default(now())
    documentFiles               DocumentFile[]
    documentSubmissions         DocumentSubmission[]
    documentsCombined           Document[]                @relation("DocumentCombinedFile")
    documentsSubmitted          Document[]                @relation("DocumentSubmittedFile")
    documentGuidanceNote        Document[]                @relation("DocumentGuidanceNoteFile")
}

model KYCFile {
    id               String            @id @default(uuid())
    file             File              @relation(fields: [fileId], references: [id])
    fileId           String
    createdBy        User              @relation(fields: [createdById], references: [id])
    createdById      String
    type             KYCFileType
    status           AcceptanceStatus?
    rejectionComment String?
    investor         Investor          @relation(fields: [investorId], references: [id])
    customDetail     CustomDetail?     @relation("KycFiles", fields: [customDetailId], references: [id])
    customDetailId   String?
    deleted          Boolean           @default(false)
    updatedAt        DateTime          @updatedAt
    createdAt        DateTime          @default(now())
    investorId       String
}

enum KYCFileType {
    PROOF_OF_ADDRESS
    PROOF_OF_IDENTITY
    INVESTMENT_VEHICLE
    FORM
    KYC_DECLARATION
    OTHER
}

enum AcceptanceStatus {
    ACCEPTED
    UNACCEPTED
    REJECTED
}

model ContractFile {
    id                    String                 @id @default(uuid())
    file                  File                   @relation("ContractFileFile", fields: [fileId], references: [id])
    fileId                String
    mip                   Mip                    @relation(fields: [mipId], references: [id])
    mipId                 String
    createdBy             User                   @relation(fields: [createdById], references: [id])
    createdById           String
    name                  String
    signatureType         SignatureType
    requiredWitnesses     Int?
    esignProvider         ESignProvider?
    type                  ContractType
    isRejected            Boolean                @default(false)
    isExpired             Boolean                @default(false)
    isHidden              Boolean                @default(false)
    signingToken          String?
    instruction           String?
    multiSignatureFile    File?                  @relation("ContractFileMultiSignatureFile", fields: [multiSignatureFileId], references: [id])
    multiSignatureFileId  String?
    counterparties        Counterparty[]
    investorContractFiles InvestorContractFile[]
    copyFrom              ContractFile?          @relation("ContractFileSelfRelation", fields: [copyFromId], references: [id])
    copyFromId            String?
    copiedFroms           ContractFile[]         @relation("ContractFileSelfRelation")
    purpose               Json?
    deleted               Boolean                @default(false)
    updatedAt             DateTime               @updatedAt
    createdAt             DateTime               @default(now())
}

enum SignatureType {
    ELECTRONIC
    WET_INK
    REVIEW
}

enum ESignProvider {
    ADDO
}

enum ContractType {
    DEAL
    SIDE_LETTER
    MULTISIGNATURE
    FORM
}

model Counterparty {
    id                      String                  @id @default(uuid())
    contract                ContractFile            @relation(fields: [contractId], references: [id])
    contractId              String
    name                    String
    type                    CounterpartyType
    counterpartySignatories CounterpartySignature[]
    deleted                 Boolean                 @default(false)
    updatedAt               DateTime                @updatedAt
    createdAt               DateTime                @default(now())
}

enum CounterpartyType {
    TWO_SIGNATORIES
    ONE_SIGNATORIES
}

model DraftCollaborator {
    id              String      @id @default(uuid())
    mip             Mip         @relation(fields: [mipId], references: [id])
    mipId           String
    name            String
    email           String
    role            ProjectRole
    isContactPerson Boolean
    isCreator       Boolean?    @default(false)
    deleted         Boolean     @default(false)
    updatedAt       DateTime    @updatedAt
    createdAt       DateTime    @default(now())
}

model InvestorContractFile {
    id                            String                      @id @default(uuid())
    contractFile                  ContractFile                @relation(fields: [contractFileId], references: [id])
    contractFileId                String
    combinedFile                  File?                       @relation("InvestorContractFileCombinedFile", fields: [combinedFileId], references: [id])
    combinedFileId                String?                     @unique
    signedFile                    File?                       @relation("InvestorContractFileSignedFile", fields: [signedFileId], references: [id])
    signedFileId                  String?                     @unique
    signedAt                      DateTime?
    isSigned                      Boolean                     @default(false)
    signingToken                  String?
    transactionShareAssociation   TransactionShareAssociation @relation(fields: [transactionShareAssociationId], references: [id])
    transactionShareAssociationId String
    contractPageIndicates         Int[]
    individualPageIndicates       Int[]
    signatoriesPageIndicates      Int[]
    counterpartySignatories       CounterpartySignature[]
    investorSignature             InvestorSignature?
    pivSignature                  PivSignature?
    combinedPageCount             Int?
    status                        DocumentStatus
    deleted                       Boolean                     @default(false)
    updatedAt                     DateTime                    @updatedAt
    createdAt                     DateTime                    @default(now())
}

model CounterpartySignature {
    id                     String                @id @default(uuid())
    // this can be optional for multi signature contract type
    investorContractFile   InvestorContractFile? @relation(fields: [investorContractFileId], references: [id])
    investorContractFileId String?
    // this is relation used only for multi signature contract type
    contractFile           File?                 @relation("CounterpartySignatureContractFile", fields: [contractFileId], references: [id])
    contractFileId         String?
    signedFile             File?                 @relation("CounterpartySignatureSignedFile", fields: [signedFileId], references: [id])
    signedFileId           String?
    counterparty           Counterparty          @relation(fields: [counterpartyId], references: [id])
    counterpartyId         String
    embedUrl               String?
    isSigned               Boolean               @default(false)
    isExpired              Boolean               @default(false)
    isRejected             Boolean               @default(false)
    rejectionComment       String?
    signedAt               DateTime?
    rejectedAt             DateTime?
    expiredAt              DateTime?
    signPageIndicate       Int
    deleted                Boolean               @default(false)
    updatedAt              DateTime              @updatedAt
    createdAt              DateTime              @default(now())
}

model InvestorSignature {
    id                     String               @id @default(uuid())
    investorContractFile   InvestorContractFile @relation(fields: [investorContractFileId], references: [id])
    investorContractFileId String               @unique
    signedFile             File?                @relation(fields: [signedFileId], references: [id])
    signedFileId           String?
    embedUrl               String?
    isSigned               Boolean              @default(false)
    isExpired              Boolean              @default(false)
    isRejected             Boolean              @default(false)
    rejectionComment       String?
    signedAt               DateTime?
    rejectedAt             DateTime?
    expiredAt              DateTime?
    signPageIndicate       Int
    deleted                Boolean              @default(false)
    updatedAt              DateTime             @updatedAt
    createdAt              DateTime             @default(now())
}

model PivSignature {
    id                     String               @id @default(uuid())
    investorContractFile   InvestorContractFile @relation(fields: [investorContractFileId], references: [id])
    investorContractFileId String               @unique
    signedFile             File?                @relation(fields: [signedFileId], references: [id])
    signedFileId           String?
    embedUrl               String?
    isSigned               Boolean              @default(false)
    isExpired              Boolean              @default(false)
    isRejected             Boolean              @default(false)
    rejectionComment       String?
    signedAt               DateTime?
    rejectedAt             DateTime?
    expiredAt              DateTime?
    signPageIndicate       Int
    deleted                Boolean              @default(false)
    updatedAt              DateTime             @updatedAt
    createdAt              DateTime             @default(now())
}

model ImportBulkV1 {
    id          String             @id @default(uuid())
    status      ImportBulkV1Status @default(INITIAL)
    payload     Json
    errorReason String?
    adminEmail  String
    startTime   DateTime?
    endTime     DateTime?
    updatedAt   DateTime           @updatedAt
    createdAt   DateTime           @default(now())
    deleted     Boolean            @default(false)
}

enum ImportBulkV1Status {
    INITIAL
    IN_PROGRESS
    ERROR
    SUCCESS
}

model Backbook {
    id        String         @id @default(uuid())
    status    BackbookStatus @default(CREATED)
    message   String?
    startTime DateTime?
    endTime   DateTime?
    payload   Json
    updatedAt DateTime       @updatedAt
    createdAt DateTime       @default(now())
    deleted   Boolean        @default(false)
}

enum BackbookStatus {
    CREATED
    IN_PROGRESS
    ERROR
    SUCCESS
}

model EtlPublish {
    id                String           @id @default(uuid())
    status            ETLPublishStatus @default(CREATED)
    payload           Json
    cleanCap          Boolean          @default(false)
    mipId             String
    previousPublishId String?
    mongoEtlEventId   String?
    message           String?
    startTime         DateTime?
    endTime           DateTime?
    updatedAt         DateTime         @updatedAt
    createdAt         DateTime         @default(now())
    deleted           Boolean          @default(false)
}

enum ETLPublishStatus {
    CREATED
    EXTRACTING_DATA
    SENDING_DATA
    INSERTING_DATA
    ERROR
    SUCCESS
}

model DocumentFile {
    id                        String                   @id @default(uuid())
    file                      File                     @relation(fields: [fileId], references: [id])
    fileId                    String
    mip                       Mip                      @relation(fields: [mipId], references: [id])
    mipId                     String
    preFillableFormTemplateId String?
    preFillableFormTemplate   PreFillableFormTemplate? @relation(fields: [preFillableFormTemplateId], references: [id])
    deleted                   Boolean                  @default(false)
    updatedAt                 DateTime                 @updatedAt
    createdAt                 DateTime                 @default(now())
    documents                 Document[]
}

model Document {
    id                         String                 @id @default(uuid())
    investor                   Investor               @relation(fields: [investorId], references: [id])
    investorId                 String
    documentFile               DocumentFile           @relation(fields: [documentFileId], references: [id])
    documentFileId             String
    combinedFile               File?                  @relation("DocumentCombinedFile", fields: [combinedFileId], references: [id])
    combinedFileId             String?
    submittedFile              File?                  @relation("DocumentSubmittedFile", fields: [submittedFileId], references: [id])
    submittedFileId            String?
    guidanceNoteFile           File?                  @relation("DocumentGuidanceNoteFile", fields: [guidanceNoteFileId], references: [id])
    guidanceNoteFileId         String?
    templateType               DocumentTemplateType
    signatureType              DocumentSignatureType
    isSignatureAdvanced        Boolean
    requiredWitnesses          Int
    individualScheduleRequired Boolean
    isSubmitted                Boolean                @default(false)
    submittedAt                DateTime?
    messageText                String?
    signingToken               String?
    documentPageIndicates      Int[]
    individualPageIndicates    Int[]
    pageCount                  Int?
    status                     DocumentStatus
    deleted                    Boolean                @default(false)
    updatedAt                  DateTime               @updatedAt
    createdAt                  DateTime               @default(now())
    documentSubmissions        DocumentSubmission[]
    documentCounterparties     DocumentCounterparty[]
}

enum DocumentSignatureType {
    ELECTRONIC
    WET_INK
    REVIEW
    SUBMITTABLE
}

enum DocumentTemplateType {
    CUSTOM
    NOTICE
    NOTICE_REQUIRING_ACKNOWLEDGMENT
    AGREEMENT
    AGREEMENT_ADVANCED_SIGNATURE
    SCHEDULE
    FORM
    UK_DEED
    POWER_OF_ATTORNEY
    SIDE_LETTER
    ANNUAL_REPORT
    VALUATION
    RESOLUTION
    PRE_FILLABLE_FORM
    GDPR_NOTICE
}

model DocumentSubmission {
    id                      String                @id @default(uuid())
    document                Document              @relation(fields: [documentId], references: [id])
    documentId              String
    submittedFile           File?                 @relation(fields: [submittedFileId], references: [id])
    submittedFileId         String?
    documentCounterparty    DocumentCounterparty? @relation(fields: [documentCounterpartyId], references: [id])
    documentCounterpartyId  String?
    submissionType          SubmissionType
    // works also as isSigned
    isSubmitted             Boolean               @default(false)
    isWitnessed             Boolean               @default(false)
    submissionPageIndicates Int[]
    submittedAt             DateTime?
    embedUrl                String?
    isExpired               Boolean               @default(false)
    isRejected              Boolean               @default(false)
    rejectionComment        String?
    rejectedAt              DateTime?
    expiredAt               DateTime?
    deleted                 Boolean               @default(false)
    updatedAt               DateTime              @updatedAt
    createdAt               DateTime              @default(now())
}

enum SubmissionType {
    INVESTOR
    COUNTERPARTY
    PIV
}

model DocumentCounterparty {
    id                  String               @id @default(uuid())
    document            Document             @relation(fields: [documentId], references: [id])
    documentId          String
    name                String
    amount              Int
    deleted             Boolean              @default(false)
    updatedAt           DateTime             @updatedAt
    createdAt           DateTime             @default(now())
    documentSubmissions DocumentSubmission[]
}

enum DocumentStatus {
    INCOMPLETE
    COMPLETE
    COMPLETED_OUTSIDE_DEALSTACK
    PENDING
    NA
}

model LoanDefinition {
    id        String             @id @default(uuid())
    mip       Mip                @relation(fields: [mipId], references: [id])
    mipId     String
    type      LoanDefinitionType @default(MANAGEMENT_LOAN)
    name      String
    funder    String
    loans     Loan[]
    deleted   Boolean            @default(false)
    updatedAt DateTime           @updatedAt
    createdAt DateTime           @default(now())

    @@unique([mipId, name, type])
}

enum LoanDefinitionType {
    MANAGEMENT_LOAN
    DEFERRED_PAYMENT
}

model Loan {
    id                            String                      @id @default(uuid())
    loanDefinition                LoanDefinition              @relation(fields: [loanDefinitionId], references: [id])
    loanDefinitionId              String
    transactionShareAssociation   TransactionShareAssociation @relation(fields: [transactionShareAssociationId], references: [id])
    transactionShareAssociationId String
    amount                        Decimal                     @db.Decimal(15, 2)
    amountRemaining               Decimal?                    @db.Decimal(15, 2)
    deleted                       Boolean                     @default(false)
    updatedAt                     DateTime                    @updatedAt
    createdAt                     DateTime                    @default(now())
}

model PreFillableFormTemplate {
    id                                     String                                  @id @default(uuid())
    preFillableFormTemplatesProjects       PreFillableFormTemplateProject[]
    file                                   File                                    @relation(fields: [fileId], references: [id])
    fileId                                 String
    name                                   String
    type                                   PreFillableFormTemplateTypeEnum
    preFillableFormTemplateFields          PreFillableFormTemplateField[]
    createdBy                              User                                    @relation(fields: [createdById], references: [id])
    createdById                            String
    documentFiles                          DocumentFile[]
    customDetails                          CustomDetail[]
    preFillableFormCustomDetailDefinitions PreFillableFormCustomDetailDefinition[]
    deleted                                Boolean                                 @default(false)
    updatedAt                              DateTime                                @updatedAt
    createdAt                              DateTime                                @default(now())
}

enum PreFillableFormTemplateTypeEnum {
    INDIVIDUAL
    VEHICLE
}

model PreFillableFormCustomDetailDefinition {
    id                            String                         @id @default(uuid())
    name                          String
    instruction                   String?
    preFillableFormTemplateFields PreFillableFormTemplateField[]
    preFillableFormTemplate       PreFillableFormTemplate?       @relation(fields: [preFillableFormTemplateId], references: [id])
    preFillableFormTemplateId     String?
    deleted                       Boolean                        @default(false)
    updatedAt                     DateTime                       @updatedAt
    createdAt                     DateTime                       @default(now())
}

model PreFillableTemplateFieldCustomDetail {
    id                             String                       @id @default(uuid())
    preFillableFormTemplateField   PreFillableFormTemplateField @relation(fields: [preFillableFormTemplateFieldId], references: [id])
    preFillableFormTemplateFieldId String
    customDetail                   CustomDetail                 @relation(fields: [customDetailId], references: [id])
    customDetailId                 String
    deleted                        Boolean                      @default(false)
    updatedAt                      DateTime                     @updatedAt
    createdAt                      DateTime                     @default(now())
}

model PreFillableFormTemplateField {
    id                                      String                                 @id @default(uuid())
    fieldKey                                String
    fieldSource                             FieldSourceEnum?
    preFillableFormTemplate                 PreFillableFormTemplate                @relation(fields: [preFillableFormTemplateId], references: [id])
    preFillableFormTemplateId               String
    preFillableTemplateFieldCustomDetails   PreFillableTemplateFieldCustomDetail[]
    preFillableFormCustomDetailDefinition   PreFillableFormCustomDetailDefinition? @relation(fields: [preFillableFormCustomDetailDefinitionId], references: [id])
    preFillableFormCustomDetailDefinitionId String?
    deleted                                 Boolean                                @default(false)
    updatedAt                               DateTime                               @updatedAt
    createdAt                               DateTime                               @default(now())
}

