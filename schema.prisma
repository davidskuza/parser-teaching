model PreFillableFormTemplateProject {
    id                        String                  @id @default(uuid())
    project                   Project                 @relation(fields: [projectId], references: [id])
    projectId                 String
    preFillableFormTemplate   PreFillableFormTemplate @relation(fields: [preFillableFormTemplateId], references: [id])
    preFillableFormTemplateId String
    deleted                   Boolean                 @default(false)
    updatedAt                 DateTime                @updatedAt
    createdAt                 DateTime                @default(now())

    @@unique([projectId, preFillableFormTemplateId])
}

model VestingTerm {
    id                          String                       @id @default(uuid())
    mip                         Mip                          @relation(fields: [mipId], references: [id])
    mipId                       String
    type                        VestingTermType
    timeBasedPercentage         Decimal                      @db.Decimal(5, 4)
    optionPeriod                Int
    optionPeriodTimeUnit        VestingTermTimeUnitType      @default(MONTHLY)
    vestingTermStraightLine     VestingTermStraightLine?
    vestingTermGraded           VestingTermGraded[]
    vestingTermLeaverProvisions VestingTermLeaverProvision[]
    shareAssociations           ShareAssociation[]
    deleted                     Boolean                      @default(false)
    updatedAt                   DateTime                     @updatedAt
    createdAt                   DateTime                     @default(now())
}

enum VestingTermType {
    STRAIGHT_LINE
    GRADED
}

model VestingTermStraightLine {
    id             String                  @id @default(uuid())
    periodTimeUnit VestingTermTimeUnitType @default(YEARLY)
    period         Int                     @default(5)
    interval       Int                     @default(1)
    cliff          Int?
    vestingTerm    VestingTerm             @relation(fields: [vestingTermId], references: [id])
    vestingTermId  String                  @unique
    deleted        Boolean                 @default(false)
    updatedAt      DateTime                @updatedAt
    createdAt      DateTime                @default(now())
}

model VestingTermGraded {
    id               String                  @id @default(uuid())
    percentage       Decimal                 @db.Decimal(5, 4)
    duration         Int
    durationTimeUnit VestingTermTimeUnitType @default(MONTHLY)
    vestingTerm      VestingTerm             @relation(fields: [vestingTermId], references: [id])
    vestingTermId    String
    deleted          Boolean                 @default(false)
    updatedAt        DateTime                @updatedAt
    createdAt        DateTime                @default(now())
}

enum VestingTermTimeUnitType {
    MONTHLY
    YEARLY
}

model VestingTermLeaverProvision {
    id                       String                         @id @default(uuid())
    type                     VestingTermLeaverProvisionType
    vestedSharesPercentage   Decimal                        @db.Decimal(5, 4)
    vestedPurchaseTerms      VestingTermPurchaseTermsType
    unvestedSharesPercentage Decimal                        @db.Decimal(5, 4)
    unvestedPurchaseTerms    VestingTermPurchaseTermsType
    vestingTerm              VestingTerm                    @relation(fields: [vestingTermId], references: [id])
    vestingTermId            String
    deleted                  Boolean                        @default(false)
    updatedAt                DateTime                       @updatedAt
    createdAt                DateTime                       @default(now())
}

enum VestingTermLeaverProvisionType {
    GOOD_LEAVER
    INTERMEDIATE_LEAVER
    BAD_LEAVER
}

enum VestingTermPurchaseTermsType {
    PURCHASE_PRICE
    FAIR_MARKET
    LOWER_PRICE
    HIGHER_PRICE
    PURCHASE_PRICE_DISCOUNT
    FAIR_MARKET_DISCOUNT
}
